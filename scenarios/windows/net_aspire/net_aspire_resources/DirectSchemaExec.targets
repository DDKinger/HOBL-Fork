<Project>
  <UsingTask TaskName="HoblDirectSchemaExec" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
             Condition="'$(ConfigurationSchemaGeneratorProjectPath)' != ''">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System.IO;
using System.Diagnostics;
using System.Globalization;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class HoblDirectSchemaExec : ToolTask
{
    [Required] public string DotNetPath { get; set; }
    [Required] public string GeneratorPath { get; set; }
    [Required] public string ResponseFile { get; set; }
    [Required] public string WorkingDirectory { get; set; }
    public string TimingDirectory { get; set; }
    public string RuntimeVersion { get; set; }

    protected override string ToolName => Path.GetFileName(DotNetPath);
    protected override string GenerateFullPathToTool() => DotNetPath;
    protected override string GetWorkingDirectory() => WorkingDirectory;

    protected override Process StartToolProcess(Process process)
    {
        if (!string.IsNullOrEmpty(TimingDirectory))
        {
            process.StartInfo.EnvironmentVariables["HOBL_SCHEMA_TIMING_DIR"] = TimingDirectory;
            process.StartInfo.EnvironmentVariables["HOBL_SCHEMA_TIMING_RSP"] = Path.GetFullPath(Path.Combine(WorkingDirectory, ResponseFile));
            process.StartInfo.EnvironmentVariables["HOBL_SCHEMA_LAUNCH_TICKS"] =
                Stopwatch.GetTimestamp().ToString(CultureInfo.InvariantCulture);
        }
        return base.StartToolProcess(process);
    }

    protected override string GenerateCommandLineCommands()
    {
        var commandLine = new CommandLineBuilder();
        commandLine.AppendSwitch("exec");
        if (!string.IsNullOrEmpty(RuntimeVersion))
        {
            commandLine.AppendSwitch("--fx-version");
            commandLine.AppendFileNameIfNotNull(RuntimeVersion);
        }
        commandLine.AppendFileNameIfNotNull(GeneratorPath);
        commandLine.AppendSwitchIfNotNull("@", ResponseFile);
        return commandLine.ToString();
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="HoblUseInstrumentedSchemaSources" BeforeTargets="CoreCompile"
          Condition="'$(HoblSchemaTimingDirectory)' != '' and '$(MSBuildProjectName)' == 'ConfigurationSchemaGenerator'">
    <ItemGroup>
      <Compile Remove="Program.cs;ConfigSchemaGenerator.cs" />
      <Compile Include="$(HoblSchemaTimingDirectory)\Program.cs;$(HoblSchemaTimingDirectory)\ConfigSchemaGenerator.cs" />
    </ItemGroup>
  </Target>

  <!-- Override only the execution target from Aspire v9.4.2; its callers still copy and compare the schema. -->
  <Target Name="CoreGenerateConfigurationSchema"
          Condition="'$(ConfigurationSchemaGeneratorProjectPath)' != ''"
          DependsOnTargets="WriteConfigurationSchemaGeneratorRspFile;CalculateConfigurationSchemaGeneratorPath"
          Inputs="$(ConfigurationSchemaGeneratorPath);@(IntermediateAssembly);@(ReferencePathWithRefAssemblies)"
          Outputs="$(GeneratedConfigurationSchemaOutputPath)">
    <HoblDirectSchemaExec DotNetPath="$(DotNetTool)"
                          GeneratorPath="$(ConfigurationSchemaGeneratorPath)"
                          ResponseFile="$(ConfigurationSchemaGeneratorRspPath)"
                          WorkingDirectory="$(MSBuildProjectDirectory)"
                          TimingDirectory="$(HoblSchemaTimingDirectory)"
                          RuntimeVersion="$(HoblSchemaRuntimeVersion)" />
    <ItemGroup>
      <FileWrites Include="$(GeneratedConfigurationSchemaOutputPath)" Condition="Exists('$(GeneratedConfigurationSchemaOutputPath)')" />
    </ItemGroup>
  </Target>
</Project>
